pipeline {
    agent any

    tools {
        maven 'Maven3'
    }

    environment {
        ECR_REPO = 'your-aws-account-id.dkr.ecr.region.amazonaws.com/java-app'
    }

    stages {
        stage('Checkout') {
            steps { git 'https://github.com/your-username/java-devsecops-pipeline.git' }
        }
        stage('Build') {
            steps { sh 'mvn clean package' }
        }
        stage('Unit Test') {
            steps { sh 'mvn test' }
        }
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    sh 'mvn sonar:sonar'
                }
            }
        }
        stage('Security Scan') {
            steps {
                sh 'dependency-check.sh --project java-app --scan .'
                sh 'trivy fs . || true'
            }
        }
        stage('Docker Build & Push') {
            steps {
                sh '''
                    docker build -t java-app .
                    docker tag java-app:latest $ECR_REPO:latest
                    aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin $ECR_REPO
                    docker push $ECR_REPO:latest
                '''
            }
        }
    }
}
